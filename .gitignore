# ---------------------------------------------------------------------------
# SmartSkip — .gitignore
# ---------------------------------------------------------------------------

# --- Gradle ---
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
.gradle-cache/
out/

# --- Local machine configuration (NEVER commit: contains absolute SDK path) ---
local.properties

# --- Android Studio / IntelliJ ---
*.iml
*.iws
*.ipr
.idea/
captures/
.navigation/

# --- Android build artifacts ---
*.apk
*.aab
*.ap_
*.aar
*.dex
*.class
bin/
gen/
release/
*.jks
*.keystore
keystore.properties
signing.properties

# --- Native / NDK ---
.externalNativeBuild/
.cxx/
obj/
*.so

# --- Kotlin ---
.kotlin/

# --- Compose compiler reports / metrics ---
compose_metrics/
*-reports/

# --- Test & coverage output ---
test-results/
reports/
jacoco.exec
*.ec

# --- Lint ---
lint-results*.html
lint-results*.xml

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Editor / tooling scratch ---
*.swp
*.swo
*~
.vscode/

# --- DSH / local agent tooling (downloaded Gradle dist, scratch) ---
.tooling/
.agent/
*.log

# --- Local runtime captures from device testing (may contain private UI text) ---
smartskip-export/
*.dumpsys
ui-dump-*.xml

# --- Secrets / local API keys ---
secrets.properties
*.local
.env
.env.*
