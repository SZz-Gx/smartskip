<?xml version="1.0" encoding="utf-8"?>
<!--
    SmartSkip — release manifest

    PRIVACY GUARANTEE (design doc §18)
    ========================================================================
    This manifest deliberately declares NO network permission: not INTERNET, not
    ACCESS_NETWORK_STATE, and no storage/camera/mic/location/contacts/SMS access.
    The Android platform therefore cannot let the release build exfiltrate the UI
    data it observes. The `debug` variant opts into INTERNET only through
    app/src/debug/AndroidManifest.xml so that WebView-based ads can be debugged.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Guards the inspector trigger. Signature level, so only a build signed with the same
        key — that is, SmartSkip itself — can request a capture of the current screen.
    -->
    <permission
        android:name="io.github.szzgx.smartskip.permission.INSPECTOR"
        android:label="@string/permission_inspector_label"
        android:description="@string/permission_inspector_description"
        android:protectionLevel="signature" />

    <application
        android:name=".SmartSkipApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartSkip">

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SmartSkip">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The core of SmartSkip. This service is the ONLY entry point through
            which the app observes other applications' UI, and it is the only
            capability the project relies on (design doc §3.1, §17).
        -->
        <service
            android:name=".accessibility.SmartSkipAccessibilityService"
            android:description="@string/accessibility_service_description"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            Lets an inspector capture be requested from outside the UI, which is how the inspector
            is used in practice: the splash ad being investigated is in another app, so a capture is
            triggered by adb and read from logcat afterwards.

            The signature-level permission is the security boundary: without it any app on the
            device could ask SmartSkip to read whatever is currently on screen.

            That guard is deliberately lifted for the debug build, because `adb shell am broadcast`
            runs as the shell user and does not hold a signature permission SmartSkip declares for
            itself — a guarded receiver is unreachable from the only tool that can capture a splash
            ad in another app. The debug overlay removes the attribute with `tools:node="remove"`,
            which is the supported way to express "release only".
        -->
        <receiver
            android:name=".accessibility.InspectorCommandReceiver"
            android:exported="true"
            android:permission="io.github.szzgx.smartskip.permission.INSPECTOR">
            <intent-filter>
                <action android:name="io.github.szzgx.smartskip.action.REQUEST_SCORED_DUMP" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
